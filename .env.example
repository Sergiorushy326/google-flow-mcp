# Attach to a Chrome the user has already logged into (preferred).
# Start that Chrome with:
#   /Applications/Google\ Chrome.app/Contents/MacOS/Google\ Chrome \
#     --remote-debugging-port=9222 \
#     --user-data-dir="$HOME/.google-flow-mcp/chrome-profile"
FLOW_CDP_URL=http://127.0.0.1:9222

# If FLOW_CDP_URL is unset the server launches its own persistent browser instead.
# FLOW_PROFILE_DIR=~/.google-flow-mcp/chrome-profile
# FLOW_BROWSER_CHANNEL=chrome
# FLOW_HEADLESS=0

# Where generated stills and clips are written.
FLOW_OUTPUT_DIR=~/flow-output

# Server state: learned API map, spend ledger, budget.
# FLOW_STATE_DIR=~/.google-flow-mcp

# Hard credit ceiling for the run. Generations that would exceed it are rejected
# before approval and cost nothing. Strongly recommended.
FLOW_BUDGET_CEILING=120

# Optional default Flow project id.
# FLOW_PROJECT_ID=
